# Clean Water Initiative — Environment Configuration
DEBUG=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# Set DEMO_MODE=true to run local simulated analysis if you do not have Google Earth Engine service account keys
DEMO_MODE=true

# Google Earth Engine Credentials (Required if DEMO_MODE=false)
# GEE_SERVICE_ACCOUNT_KEY=C:\path\to\gee-key.json
# GEE_PROJECT_ID=your-gcp-project-id
# GEE_SERVICE_ACCOUNT_EMAIL=your-sa@your-gcp-project-id.iam.gserviceaccount.com

# Database (Leave empty for default local SQLite ./dev.db)
# DATABASE_URL=
