# ── App ──────────────────────────────────────────────────────────────────────
DEBUG=false

# Comma-separated frontend origins allowed for CORS
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Supabase Postgres connection string (use the pooler URL for serverless)
DATABASE_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:6543/postgres

# ── Google Earth Engine ──────────────────────────────────────────────────────
# Paste the ENTIRE contents of your GEE service account JSON key file here
# See docs/GEE_SETUP.md for step-by-step instructions
GEE_SERVICE_ACCOUNT_KEY={"type": "service_account", "project_id": "...", ...}
GEE_PROJECT_ID=your-gcp-project-id
GEE_SERVICE_ACCOUNT_EMAIL=your-sa@your-project.iam.gserviceaccount.com
